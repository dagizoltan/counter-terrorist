[Unit]
Description=Counter-Terrorist Security Orchestrator
After=network.target

[Service]
Type=simple
User=cts
WorkingDirectory=/var/lib/cts
ExecStart=/usr/bin/counter-terrorist
EnvironmentFile=/etc/counter-terrorist/orchestrator.env
Restart=always
RestartSec=5

# Hardening
CapabilityBoundingSet=CAP_NET_ADMIN CAP_KILL CAP_DAC_OVERRIDE CAP_BPF CAP_NET_RAW CAP_SYS_ADMIN
AmbientCapabilities=CAP_NET_ADMIN CAP_KILL CAP_DAC_OVERRIDE CAP_BPF CAP_NET_RAW CAP_SYS_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/cts /etc/counter-terrorist /proc/sys/kernel/randomize_va_space /proc/sys/net/ipv4/tcp_syncookies

[Install]
WantedBy=multi-user.target
