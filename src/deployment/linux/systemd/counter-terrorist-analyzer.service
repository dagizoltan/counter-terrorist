[Unit]
Description=Counter-Terrorist Analyzer Daemon
After=network.target

[Service]
Type=simple
User=cts
WorkingDirectory=/var/lib/cts
# For the integrated model, the orchestrator manages this process directly.
ExecStart=/usr/lib/counter-terrorist/agents/analyzer
Restart=always
RestartSec=5

# Hardening
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=CAP_DAC_OVERRIDE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cts

[Install]
WantedBy=multi-user.target
