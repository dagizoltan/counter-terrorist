<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cts.orchestrator</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/counter-terrorist</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/cts/orchestrator.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/cts/orchestrator_err.log</string>
    <key>WorkingDirectory</key>
    <string>/usr/local/lib/counter-terrorist</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>8000</string>
        <key>LOG_LEVEL</key>
        <string>INFO</string>
    </dict>
</dict>
</plist>
