[Unit]
Description=Counter-Terrorist Security Orchestrator
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/counter-terrorist
ExecStart=/usr/bin/deno run --allow-net --allow-read --allow-run --allow-sys orchestrator/main.ts
EnvironmentFile=/etc/counter-terrorist/orchestrator.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
