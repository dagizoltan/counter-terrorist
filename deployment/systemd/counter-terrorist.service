[Unit]
Description=Counter-Terrorist Security Orchestrator
After=network.target

[Service]
Type=simple
User=cts
WorkingDirectory=/opt/counter-terrorist
ExecStart=/usr/bin/deno run --allow-net --allow-read --allow-run --allow-sys orchestrator/main.ts
EnvironmentFile=/etc/counter-terrorist/orchestrator.env
Restart=always
RestartSec=5

# Hardening
CapabilityBoundingSet=CAP_NET_ADMIN CAP_KILL CAP_DAC_OVERRIDE CAP_BPF
AmbientCapabilities=CAP_NET_ADMIN CAP_KILL CAP_DAC_OVERRIDE CAP_BPF
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cts /etc/counter-terrorist

[Install]
WantedBy=multi-user.target
