#!/bin/bash
set -e

# Create dedicated cts user
if ! id "cts" &>/dev/null; then
    useradd -r -s /bin/false cts
fi

# Set up required directories and permissions
mkdir -p /var/lib/cts
chown -R cts:cts /var/lib/cts

# Ensure env file is secure
if [ -f "/etc/counter-terrorist/orchestrator.env" ]; then
    chown cts:cts /etc/counter-terrorist/orchestrator.env
    chmod 600 /etc/counter-terrorist/orchestrator.env
fi

# Reload systemd to recognize new services
systemctl daemon-reload

# Enable but don't start services by default
systemctl enable counter-terrorist.service
systemctl enable counter-terrorist-scanner.service

echo "Counter-Terrorist installed successfully."
echo "Please configure /etc/counter-terrorist/orchestrator.env and start the service."
