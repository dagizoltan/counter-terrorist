{
  "tasks": {
    "setup": "deno run --allow-read=./ --allow-write=./.env --allow-env src/orchestrator/tools/ops/init_env.ts",
    "bootstrap": "deno run --allow-all src/orchestrator/app/bootstrapper.ts",
    "build-agents": "cd src/agents && cargo build --release && cd ../.. && deno run -A src/orchestrator/tools/build/update_sidecar_manifest.ts",
    "build-css": "deno run --allow-read --allow-write src/orchestrator/tools/build/build_css.ts",
    "check-css": "deno run --allow-read src/orchestrator/tools/build/build_css.ts --check",
    "start": "deno run --allow-net --allow-env --allow-ffi --allow-read --allow-write=./,/var/lib/cts,/tmp --allow-sys=hostname,osRelease,uid,gid,networkInterfaces,systemMemoryInfo,loadavg,cpus --allow-run --unstable-kv src/orchestrator/index.ts",
    "start:single-node": "SINGLE_NODE=true deno run --allow-net --allow-env --allow-ffi --allow-read --allow-write=./,/var/lib/cts,/tmp --allow-sys=hostname,osRelease,uid,gid,networkInterfaces,systemMemoryInfo,loadavg,cpus --allow-run --unstable-kv src/orchestrator/index.ts",
    "dev": "deno run -A --env --unstable-kv --watch src/orchestrator/index.ts",
    "doctor": "deno run -A --unstable-kv src/orchestrator/tools/ops/cts_doctor.ts",
    "install-sovereign": "deno run -A src/orchestrator/tools/ops/installer.ts",
    "provision-integrity": "deno run -A src/orchestrator/tools/provision_integrity.ts",
    "package": "deno run --allow-run --allow-read --allow-write --allow-net src/orchestrator/tools/build/package.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "hono": "npm:hono@4.3.7",
    "hono/": "npm:/hono@4.3.7/",
    "hono/bearer-auth": "npm:/hono@4.3.7/bearer-auth",
    "hono/deno": "npm:/hono@4.3.7/deno",
    "hono/jsx": "npm:/hono@4.3.7/jsx",
    "hono/jsx/jsx-runtime": "npm:/hono@4.3.7/jsx/jsx-runtime",
    "zod": "npm:zod@^4.4.1",
    "@core/": "./src/orchestrator/core/",
    "@domain/": "./src/orchestrator/domain/",
    "@infrastructure/": "./src/orchestrator/infrastructure/",
    "@interface/": "./src/orchestrator/interface/web/",
    "@orchestrator/": "./src/orchestrator/",
    "@app/": "./src/orchestrator/app/",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/toml": "jsr:@std/toml@^0.224.0",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/fs/": "jsr:@std/fs@^0.224.0/",
    "@std/crypto": "jsr:@std/crypto@^0.224.0",
    "@std/encoding/": "jsr:@std/encoding@^0.224.0/",
    "@std/testing/": "jsr:@std/testing@^0.224.0/",
    "@std/async/": "jsr:@std/async@^0.224.0/",
    "@interface/routes/": "./src/orchestrator/interface/web/routes/"
  }
}
