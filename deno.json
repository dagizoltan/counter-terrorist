{
  "tasks": {
    "start": "ALLOW_HARDWARE_BYPASS=true deno run --allow-all --unstable-kv --unstable-net src/orchestrator/main.ts",
    "start:strict": "deno run --allow-net=0.0.0.0:8000 --allow-read=./,/etc/os-release,/var/lib/cts --allow-write=/var/lib/cts --allow-run=./src/agents/target/release/scanner,./src/agents/target/release/blocker,./src/agents/target/release/honeypot,./src/agents/target/release/pcap,./src/agents/target/release/ebpf,ufw,openssl --allow-sys=hostname,osRelease --allow-env --unstable-kv src/orchestrator/main.ts",
    "dev": "deno run --env --allow-net --allow-read --allow-write --allow-run --allow-sys --allow-env --unstable-kv --unstable-net --watch src/orchestrator/main.ts",
    "bootstrap": "deno run --allow-all src/orchestrator/bootstrapper.ts",
    "build-agents": "cd src/agents && cargo build --release && cargo build --release --package ebpf",
    "package": "deno run --allow-run --allow-read --allow-write --allow-net src/orchestrator/tools/build/package.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "hono": "https://deno.land/x/hono@v4.3.7/mod.ts",
    "hono/": "https://deno.land/x/hono@v4.3.7/",
    "hono/bearer-auth": "https://deno.land/x/hono@v4.3.7/middleware/bearer-auth/index.ts",
    "hono/deno": "https://deno.land/x/hono@v4.3.7/adapter/deno/index.ts",
    "hono/jsx": "https://deno.land/x/hono@v4.3.7/jsx/index.ts",
    "hono/jsx/jsx-runtime": "https://deno.land/x/hono@v4.3.7/jsx/jsx-runtime.ts",
    "zod": "npm:zod@^4.4.1",
    "@core/": "./src/orchestrator/core/",
    "@domain/": "./src/orchestrator/domain/",
    "@infrastructure/": "./src/orchestrator/infrastructure/",
    "@api/": "./src/orchestrator/interface/web/api/",
    "@interface/": "./src/orchestrator/interface/web/",
    "@orchestrator/": "./src/orchestrator/",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0"
  }
}
