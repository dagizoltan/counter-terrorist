{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-run --allow-sys --allow-env orchestrator/main.ts",
    "dev": "deno run --allow-net --allow-read --allow-run --allow-sys --allow-env --watch orchestrator/main.ts",
    "bootstrap": "deno run --allow-run --allow-read --allow-sys orchestrator/bootstrapper.ts",
    "build-agents": "cd agents && cargo build --release && cargo build --release --package ebpf",
    "package": "deno run --allow-run --allow-read --allow-write orchestrator/scripts/package.ts"
  },
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment"
  },
  "imports": {
    "hono": "https://deno.land/x/hono@v4.3.7/mod.ts",
    "hono/": "https://deno.land/x/hono@v4.3.7/",
    "hono/bearer-auth": "https://deno.land/x/hono@v4.3.7/middleware/bearer-auth/index.ts",
    "hono/deno": "https://deno.land/x/hono@v4.3.7/adapter/deno/index.ts",
    "hono/jsx": "https://deno.land/x/hono@v4.3.7/jsx/index.ts"
  }
}
