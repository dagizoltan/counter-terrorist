{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write=./,/var/lib/cts --allow-run=./src/agents/target/release/analyzer,./src/agents/target/release/enforcer,./src/agents/target/release/decoy,./src/agents/target/release/netcap,./src/agents/target/release/sentinel,./src/agents/target/release/watchfile,./src/agents/target/release/trustroot,./src/agents/target/release/tunnel,./src/agents/target/release/mesh,ufw,/usr/bin/sha256sum,/usr/bin/which,/usr/bin/sudo,/usr/sbin/ip,/usr/bin/ls,/usr/bin/cat,/usr/bin/grep,/usr/sbin/sysctl,deno,/usr/bin/ss --allow-sys=hostname,osRelease,uid,loadavg,systemMemoryInfo,networkInterfaces --allow-env --unstable-kv src/orchestrator/index.ts",
    "start:dev-UNSAFE": "ALLOW_HARDWARE_BYPASS=true deno run --allow-all --unstable-kv src/orchestrator/index.ts",
    "dev": "deno run --env --allow-net --allow-read --allow-write --allow-run --allow-sys --allow-env --unstable-kv --watch src/orchestrator/index.ts",
    "bootstrap": "deno run --allow-all src/orchestrator/bootstrapper.ts",
    "build-agents": "cd src/agents && cargo build --release",
    "install-sovereign": "deno run -A src/orchestrator/tools/ops/installer.ts",
    "provision-integrity": "deno run -A src/orchestrator/tools/provision_integrity.ts",
    "package": "deno run --allow-run --allow-read --allow-write --allow-net src/orchestrator/tools/build/package.ts"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "imports": {
    "hono": "https://deno.land/x/hono@v4.3.7/mod.ts",
    "hono/": "https://deno.land/x/hono@v4.3.7/",
    "hono/bearer-auth": "https://deno.land/x/hono@v4.3.7/middleware/bearer-auth/index.ts",
    "hono/deno": "https://deno.land/x/hono@v4.3.7/adapter/deno/index.ts",
    "hono/jsx": "https://deno.land/x/hono@v4.3.7/jsx/index.ts",
    "hono/jsx/jsx-runtime": "https://deno.land/x/hono@v4.3.7/jsx/jsx-runtime.ts",
    "zod": "npm:zod@^4.4.1",
    "@core/": "./src/orchestrator/core/",
    "@domain/": "./src/orchestrator/domain/",
    "@infrastructure/": "./src/orchestrator/infrastructure/",
    "@api/": "./src/orchestrator/interface/web/api/",
    "@interface/": "./src/orchestrator/interface/web/",
    "@orchestrator/": "./src/orchestrator/",
    "@app/": "./src/orchestrator/app/",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0"
  }
}
