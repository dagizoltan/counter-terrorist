{
  "tasks": {
    "start": "deno run --allow-net=0.0.0.0:8000,224.0.0.251:5353 --allow-read=./,/etc/os-release,/proc,/var/lib/cts,/tmp --allow-write=/var/lib/cts,/tmp --allow-run=./agents/target/release/scanner,./agents/target/release/blocker,./agents/target/release/honeypot,./agents/target/release/pcap,./agents/target/release/ebpf,ufw,ss,which,clamscan,rkhunter,openssl --allow-sys=hostname,osRelease,uid --allow-env --unstable-kv --unstable-net orchestrator/main.ts",
    "start:strict": "deno run --allow-net=0.0.0.0:8000 --allow-read=./,/etc/os-release,/var/lib/cts --allow-write=/var/lib/cts --allow-run=./agents/target/release/scanner,./agents/target/release/blocker,./agents/target/release/honeypot,./agents/target/release/pcap,./agents/target/release/ebpf,ufw,openssl --allow-sys=hostname,osRelease --allow-env --unstable-kv orchestrator/main.ts",
    "dev": "deno run --allow-net --allow-read --allow-write --allow-run --allow-sys --allow-env --unstable-kv --unstable-net --watch orchestrator/main.ts",
    "bootstrap": "deno run --allow-run --allow-read --allow-sys orchestrator/bootstrapper.ts",
    "build-agents": "cd agents && cargo build --release && cargo build --release --package ebpf",
    "package": "deno run --allow-run --allow-read --allow-write orchestrator/scripts/package.ts"
  },
  "compilerOptions": {
    "jsx": "react",
    "jsxFactory": "jsx",
    "jsxFragmentFactory": "Fragment"
  },
  "imports": {
    "hono": "https://deno.land/x/hono@v4.3.7/mod.ts",
    "hono/": "https://deno.land/x/hono@v4.3.7/",
    "hono/bearer-auth": "https://deno.land/x/hono@v4.3.7/middleware/bearer-auth/index.ts",
    "hono/deno": "https://deno.land/x/hono@v4.3.7/adapter/deno/index.ts",
    "hono/jsx": "https://deno.land/x/hono@v4.3.7/jsx/index.ts"
  }
}
