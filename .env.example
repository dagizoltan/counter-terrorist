# Sovereign Orchestrator - Environment Configuration
# All security-critical variables MUST be set in production.

# --- Security ---
API_TOKEN=                            # Master Bearer Token (min 32 chars)
SECURE_BYPASS_TOKEN=                  # Mandatory hardware integrity bypass (min 32 chars)
PKI_SECRET=                           # Master secret for node certificate generation
MESH_SECRET=                          # Shared secret for P2P Gossip HMAC signatures
STRICT_HARDWARE_INTEGRITY=false        # Set to true to fail-shut on TPM failure
SECURE_ENVIRONMENT_TOKEN=              # Value matching SECURE_BYPASS_TOKEN to engage bypass

# --- Operational ---
ENVIRONMENT=development                # production, development, staging
PORT=8000                              # Bind port for the orchestrator
SINGLE_NODE=false                      # Set to true for isolated operation without mesh

# --- Intelligence ---
INTEL_SYNC_INTERVAL_HOURS=1            # Frequency of external threat intel fetching
INTEL_ALLOWLIST=127.0.0.1,10.0.0.0/8   # Comma-separated IPs/CIDRs to never block

# --- Governance ---
STRICT_POLICY_ENFORCEMENT=false        # Enable automated autonomous remediations
SESSION_TTL_HOURS=24                   # Web console session duration
